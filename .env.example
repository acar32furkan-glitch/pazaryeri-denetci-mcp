# Örnek ortam değişkenleri — gerçek değerleri .env dosyasına yazın, depoya ASLA commit etmeyin.
# Bu dosya yalnızca hangi değişkenlerin okunduğunu belgeler.

# --- LLM öneri katmanı (Faz 5) -------------------------------------------------
# Anahtar boşsa uygulama çalışmaya devam eder; suggest_fix "devre dışı" der.
# Model adı koda gömülmez, yalnızca buradan okunur.
ANTHROPIC_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS_PER_REQUEST=1024
LLM_DAILY_TOKEN_BUDGET=200000
# MCP sunucusunda öneri modu: auto (ortama bak) | mock (sahte demo istemcisi) | off (kapalı)
MCP_LLM_MODE=auto
# Önbellek süreç belleğindedir (diske yazılmaz): aynı girdi ikinci kez LLM'e gitmez.
# Gerekçe: docs/DECISIONS.md ADR-016 — "varsayılan salt-okunur" ilkesi dosya yazmayı da kapsar.

# --- MCP HTTP taşıma (Faz 4) ---------------------------------------------------
MCP_HTTP_PORT=8787
MCP_HTTP_TOKEN=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
ALLOWED_ORIGINS=http://localhost:3000

# --- Katalog / günlük ----------------------------------------------------------
CATALOG_PATH=examples/catalog.json
LOG_LEVEL=info

# --- MCP sunucusu katalog kaynağı (stdio) --------------------------------------
# CATALOG_PATH verilirse ondan okur; verilmezse sentetik katalog üretilir.
MOCK_CATALOG_PRODUCTS=200
MOCK_CATALOG_SEED=20261013
MOCK_CATALOG_DEFECTS_PER_KIND=5
