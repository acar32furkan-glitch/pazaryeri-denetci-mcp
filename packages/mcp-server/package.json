{
  "name": "@pazaryeri-denetci/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP sunucusu: salt-okunur araçlar, kaynaklar ve prompt şablonları (SDK v2)",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "esbuild src/bin.ts src/http-bin.ts src/index.ts --bundle --format=esm --platform=node --target=node20 --outdir=dist --packages=external --sourcemap",
    "start": "node dist/bin.js",
    "start:http": "node dist/http-bin.js"
  },
  "bin": {
    "pazaryeri-denetci-mcp": "./dist/bin.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@pazaryeri-denetci/catalog-io": "workspace:*",
    "@pazaryeri-denetci/core": "workspace:*",
    "@pazaryeri-denetci/mock-data": "workspace:*",
    "zod": "^4.6.7",
    "@pazaryeri-denetci/suggest": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "esbuild": "^0.28.2"
  }
}
